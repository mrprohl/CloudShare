# ============================================================================
# CloudShare – site block for the central Caddy (template). setup.sh writes caddy/cloudshare.caddy from it with
# the host of PUBLIC_BASE_URL; the directory is mounted read-only into the central Caddy at the same path.
# TLS (Let's Encrypt) is handled by the central Caddy, so ports 80/443 must reach it (directly or forwarded).
# After changes:  docker exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# No X-Frame-Options / frame-ancestors here: new Outlook and Outlook on the web show the taskpane in an iframe.
# ============================================================================

# Explicit redirect – needed if the central Caddy runs with auto_https disable_redirects.
# ACME HTTP-01 challenges are still answered by Caddy itself before this route.
http://cloudshare.example.com {
	redir https://cloudshare.example.com{uri} 308
}

https://cloudshare.example.com {
	encode zstd gzip

	# Uploads arrive in chunks of 10 MiB (plus headroom) – larger requests are never needed
	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy cloudshare:3000
}
