# CloudShare – app settings and secrets. Reference only; setup.sh writes env/cloudshare.env (600).

# Public address of the add-in (without trailing slash)
PUBLIC_BASE_URL=https://cloudshare.example.com

# Language of the mails and SMS CloudShare sends (password mail and SMS, confirmations): a file in locales/ (de, en).
# The add-in itself follows the Outlook language of each user (English if there is no file for it).
# Own languages or changed texts: env/config/locales/<language>.json (see README, "Languages"). After a change:
# update the stack, then clear the Outlook cache (classic) or reload Outlook on the web.
LANGUAGE=en

# Entra ID app registration "CloudShare"
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Nextcloud (users connect once via Login Flow v2)
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_FOLDER=CloudShare
# Folder for received files (upload links, "Dateien von Empfängern erhalten"); every link gets its own subfolder
NEXTCLOUD_REQUEST_FOLDER=CloudShare-File-Requests

# Key for the encrypted storage of the Nextcloud app passwords: openssl rand -base64 32
# Changing it invalidates all existing connections (users must reconnect).
CREDENTIAL_KEY=

# Behaviour
# From this size per attachment CloudShare steps in (info bar while composing + check on send).
# No upload limit – the user's Nextcloud quota applies.
# 0 = every attachment (all preselected in the pane, no "Groß" mark) – best with ATTACHMENT_POLICY=suggest.
ATTACHMENT_THRESHOLD_MB=5
# Inside the organisation a size of its own (unset = ATTACHMENT_THRESHOLD_MB), e.g. 0 outside, 5 inside. Internal are
# INTERNAL_DOMAINS (comma-separated, subdomains included; empty = the user's own domain); without recipients: internal.
#ATTACHMENT_THRESHOLD_INTERNAL_MB=5
#INTERNAL_DOMAINS='example.com, example.de'
# enforce = mails with larger attachments can only be sent via CloudShare (no "Send anyway")
# suggest = prompt on send: "CloudShare öffnen" or "Trotzdem senden" (attachments go out normally)
# Changing it only needs a stack update – the add-in does not have to be redeployed.
ATTACHMENT_POLICY=suggest
# The same for mails whose recipients are all internal (INTERNAL_DOMAINS); unset = ATTACHMENT_POLICY.
#ATTACHMENT_POLICY_INTERNAL=suggest
# Sensitivity labels (Microsoft Purview) of shared files – read in the add-in from the file itself:
#   LABEL_POLICY     inherit = the message gets the highest label of its files (default), suggest = only offered, off
#   LABEL_ENCRYPTED  warn = confirm files encrypted by their label (default), block = refuse them, allow = no question
#LABEL_POLICY=inherit
#LABEL_ENCRYPTED=warn
# Signature of the password mails (so recipients see who the password comes from) for every user without an own one
# in the settings; empty = none. Template with placeholders filled from the sender's Microsoft 365 profile: {displayName} {givenName} {surname} {jobTitle} {department} {company} {email}
# {phone} {mobile} {office}. Plain text: "\n" starts a new line, "\n\n" a new paragraph (shown like the text of the
# mail). Segments separated by " · " whose placeholders are all empty are left out (e.g. "Tel. {phone}" without a
# phone number). Keep the single quotes.
# Example: MAIL_FOOTER='Mit freundlichen Grüßen\n\n{displayName} · {department}\n{company} · Tel. {phone} · {email}'
MAIL_FOOTER=
SHARE_EXPIRE_DAYS=14
SHARE_MAX_EXPIRE_DAYS=90

# Vaultwarden service account
VAULTWARDEN_URL=https://vault.example.com
BW_CLIENTID=
BW_CLIENTSECRET=
BW_PASSWORD=
# How often the password link (Vaultwarden Send) can be opened: default per link (user can change it in the
# taskpane) and upper limit
SEND_MAX_ACCESS_COUNT=3
SEND_MAX_ACCESS_LIMIT=20
# Days the password link and confidential messages stay available: default (user can change it in the taskpane)
# and upper limit – at most 30, Vaultwarden keeps Sends at most 31 days
SEND_EXPIRE_DAYS=5
SEND_MAX_EXPIRE_DAYS=30
# true: the password page names the address of CloudShare's Vaultwarden account ("… created this Send") instead of
# warning that the creator hid it – give that account an address recipients recognise. Default: hidden.
#SEND_SHOW_CREATOR=true

# Uploaded files (NEXTCLOUD_FOLDER) are deleted – into the user's Nextcloud trash – this many days after their link
# expired; 0 = right after expiry (default), off = never. Received files (NEXTCLOUD_REQUEST_FOLDER) are never deleted.
#CLEANUP_AFTER_DAYS=0

# Stored entries (database /data/cloudshare.db) not changed for this many days are deleted by a daily pass; default
# 365, off = never. A safety net – entries normally leave earlier on their own. Nextcloud connections and the cleanup
# list are never affected. Must be at least SHARE_MAX_EXPIRE_DAYS.
#DATA_RETENTION_DAYS=365

# Password by SMS (optional, "Kennwort senden an: Rufnummer (SMS)"): seven.io account (https://www.seven.io). Without an
# API key the option is not offered. Sender: phone number or up to 11 letters/digits. Delivery reports: set the
# callback URL https://<host>/webhooks/seven?token=<SEVEN_WEBHOOK_SECRET> in the seven.io dashboard.
#SEVEN_API_KEY=
#SEVEN_SENDER=CloudShare
# Webhook secret: openssl rand -hex 24
#SEVEN_WEBHOOK_SECRET=
# Country code for numbers entered as 0170 …, and the SMS limit per user and day
#SMS_DEFAULT_COUNTRY=49
#SMS_MAX_PER_DAY=50
# Countries SMS may go to (empty = all). Separated by commas or semicolons, each written any of these ways:
# ISO code (DE, DEU), calling code (+49, 0049, 49), name in German or English (Deutschland, Germany, Österreich,
# Oesterreich), short forms (UK, USA) or groups (DACH, EU, EWR/EEA). Numbers are told apart by their calling code
# only: allowing USA also allows Canada and the Caribbean (+1). SMS_DEFAULT_COUNTRY must be one of them.
#SMS_ALLOWED_COUNTRIES=DE, AT, CH
# Rules on the number itself, as regular expressions on the number in international form (+491701234567), checked
# after the countries. Mobile and landline numbers are allowed. SMS_BLOCKED_NUMBERS: numbers that match are refused –
# by default the German service numbers 0800 (freephone), 0900 (premium rate) and 0180 (shared cost); set it empty
# ('') to allow them. SMS_ALLOWED_NUMBERS: if set, only numbers that match are accepted – e.g. only German mobile
# numbers (015…, 016…, 017…). Single quotes, so neither the shell nor Compose touches \ and $.
#SMS_BLOCKED_NUMBERS='^\+49(800|900|180)'
#SMS_ALLOWED_NUMBERS='^\+491(5|6|7)\d{8,9}$'

# Download confirmation (optional): the sender gets a mail when a recipient first downloads a file. Needs the
# Entra application permission Mail.Send (admin consent), limited to the CloudShare users with Exchange RBAC for
# applications – see docs/architecture.md.
#DOWNLOAD_NOTICE=true
# Upload notification (optional): the sender gets a mail when files arrive through an upload link ("Anfordern"),
# at most one per link every 10 minutes. Same application permission Mail.Send as the download confirmation.
#UPLOAD_NOTICE=true
# Note about an undelivered SMS (optional): the sender gets a mail when seven.io reports the password SMS as not
# delivered later. Same application permission Mail.Send. Unset it follows DOWNLOAD_NOTICE.
#SMS_NOTICE=true
# Delivery proof ("Zustellnachweis", optional): offered in the pane, ticked per mail by the sender – tracking ID,
# hash-chained record of sending, password, downloads, the recipient confirms their address with a code, PDF in
# "Verlauf". The code mail needs the application permission Mail.Send, so unset it follows DOWNLOAD_NOTICE.
#DELIVERY_PROOF=true
# How long a delivery proof is kept after its last event (days; default 1095 = three years).
#PROOF_RETENTION_DAYS=1095

# --- Defaults of the personal settings -------------------------------------------------------------------------
# Every user can change these for themselves in the add-in (account menu at the bottom left → Einstellungen); what is set here is where
# everyone starts (and stays, as long as they leave a setting alone). The organisation's rules are not part of it:
# SMS countries and numbers, the notice switches above, SMS without seven.io – users only choose within them.
# Ways "Kennwort senden an" offers (recipients = recipients of the message, mail = another address, sms) and the
# one preselected for a new message:
DEFAULT_PASSWORD_CHANNELS=recipients,mail,sms
DEFAULT_PASSWORD_CHANNEL=recipients
# Notices – only where DOWNLOAD_NOTICE / UPLOAD_NOTICE / SMS_NOTICE are on; false = users start without them:
DEFAULT_DOWNLOAD_NOTICE=true
DEFAULT_UPLOAD_NOTICE=true
DEFAULT_SMS_NOTICE=true
# Language of the add-in: auto (as in Outlook) or a language of locales/ (de, en). Mails and SMS use LANGUAGE.
DEFAULT_LANGUAGE=auto
# The default signature of the password mails is MAIL_FOOTER; users may set an own one (plain text).

# Text templates (SMS, password mail, download confirmation): env/config/templates.json, see templates.example.json.

# Requests per minute and user (or client address); Nextcloud login and upload links get 1/60 of it.
# 600 is plenty for normal use – a 5 GB upload is about 500 requests.
#RATE_LIMIT_PER_MINUTE=600

# Messages in the pane disappear after this many seconds (a ring around the tick, "!" or "i" runs down; it stops
# while the pointer is on the message). 0 = they stay. Progress ("Uploading …") and a failed start ("Erneut versuchen")
# always stay.
#SUCCESS_MESSAGE_SECONDS=5

# Diagnostics: the send check (Smart Alert) reports its steps to the server log ("Smart Alert trace").
# Only switch on to find where sending hangs in a client; no login, so leave it off otherwise.
#CLIENT_TRACE=true
