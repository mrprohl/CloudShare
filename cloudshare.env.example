# CloudShare – app settings and secrets. Reference only; setup.sh writes env/cloudshare.env (600).

# Public address of the add-in (without trailing slash)
PUBLIC_BASE_URL=https://cloudshare.example.com

# Entra ID app registration "CloudShare"
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Nextcloud (users connect once via Login Flow v2)
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_FOLDER=CloudShare
# Folder for received files (upload links, "Dateien von Empfängern erhalten"); every link gets its own subfolder
NEXTCLOUD_REQUEST_FOLDER=Outlook-Dateianforderungen

# Key for the encrypted storage of the Nextcloud app passwords: openssl rand -base64 32
# Changing it invalidates all existing connections (users must reconnect).
CREDENTIAL_KEY=

# Behaviour
# From this size per attachment CloudShare steps in (info bar while composing + check on send).
# No upload limit – the user's Nextcloud quota applies.
ATTACHMENT_THRESHOLD_MB=1
# enforce = mails with larger attachments can only be sent via CloudShare (no "Send anyway")
# suggest = prompt on send: "CloudShare öffnen" or "Trotzdem senden" (attachments go out normally)
# Changing it only needs a stack update – the add-in does not have to be redeployed.
ATTACHMENT_POLICY=enforce
# Optional footer of the card inserted into the mail; empty = none. Template with placeholders filled from the
# sender's Microsoft 365 profile: {displayName} {givenName} {surname} {jobTitle} {department} {company} {email}
# {phone} {mobile} {office}. "\n" starts a new line. Segments separated by " · " whose placeholders are all
# empty are left out (e.g. "Tel. {phone}" without a phone number). Keep the single quotes.
MAIL_FOOTER='{displayName} · {jobTitle}\n{company} · Tel. {phone} · {email}'
SHARE_EXPIRE_DAYS=14
SHARE_MAX_EXPIRE_DAYS=90

# Vaultwarden service account
VAULTWARDEN_URL=https://vault.example.com
BW_CLIENTID=
BW_CLIENTSECRET=
BW_PASSWORD=
# How often the password link (Vaultwarden Send) can be opened: default per link (user can change it in the
# taskpane) and upper limit
SEND_MAX_ACCESS_COUNT=3
SEND_MAX_ACCESS_LIMIT=20
SEND_EXPIRE_DAYS=7

# Uploaded files (NEXTCLOUD_FOLDER) are deleted – into the user's Nextcloud trash – this many days after their link
# expired; 0 = right after expiry (default), off = never. Received files (NEXTCLOUD_REQUEST_FOLDER) are never deleted.
#CLEANUP_AFTER_DAYS=0

# Requests per minute and user (or client address); Nextcloud login and upload links get 1/60 of it.
# 600 is plenty for normal use – a 5 GB upload is about 500 requests.
#RATE_LIMIT_PER_MINUTE=600

# Diagnostics: the send check (Smart Alert) reports its steps to the server log ("Smart Alert trace").
# Only switch on to find where sending hangs in a client; no login, so leave it off otherwise.
#CLIENT_TRACE=true
