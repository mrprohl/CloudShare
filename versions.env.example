# Compose variables for CloudShare – template; setup.sh copies it to env/versions.env
# To change: edit env/versions.env, then update the stack (with re-pull for a new image).

# Image version: latest = newest state of main (GitHub builds the image on every push), updated by re-pull.
# To pin a state: sha-<commit> or a version from a Git tag (e.g. 1.0.0).
CLOUDSHARE_VERSION=latest
# Image repository (only change it for your own build)
#CLOUDSHARE_IMAGE=ghcr.io/mrprohl/cloudshare

# Nextcloud behind the same central Caddy: its host name and the Caddy's address in cloudshare-proxy.
# CloudShare then reaches Nextcloud internally. Nextcloud elsewhere: comment out NEXTCLOUD_HOST.
NEXTCLOUD_HOST=cloud.example.com
PROXY_IP=172.30.13.2

#TZ=Europe/Berlin
